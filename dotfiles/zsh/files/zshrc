# basic

setopt no_beep
setopt pushd_ignore_dups
setopt extended_glob

bindkey -e

export LC_CTYPE=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8

COMP_WORDBREAKS=${COMP_WORDBREAKS/=/}
COMP_WORDBREAKS=${COMP_WORDBREAKS/@/}
export COMP_WORDBREAKS
export WORDCHARS=''
export EDITOR="vim"
export GIT_EDITOR="vim"
export CLICOLOR=1
export LSCOLORS="gxfxcxdxbxegedabagacad"
export GPG_TTY=$TTY

export PATH=~/.local/share/mise/shims:/usr/local/bin:/usr/local/sbin:/usr/libexec:~/go/bin:~/bin:~/.local/bin:$PATH

# prompt (sync, so the prompt isn't redrawn after startup)

# use the real binary (the mise shim adds ~30ms per call) and a cached init script
_starship=~/.local/share/mise/installs/starship/latest/starship
_starship_init=${XDG_CACHE_HOME:-$HOME/.cache}/starship-init.zsh
if [[ ! -s $_starship_init || $_starship -nt $_starship_init ]]; then
  mkdir -p ${_starship_init:h} && PATH=${_starship:h}:$PATH $_starship init zsh --print-full-init > $_starship_init
fi
source $_starship_init
unset _starship _starship_init

# plugins (sheldon; list in ~/.config/sheldon/plugins.toml)

bindkey '^P' history-substring-search-up
bindkey '^N' history-substring-search-down

bindkey "^Xz" zce
zstyle ':zce:*' fg 'fg=red,bold'
zstyle ':zce:*' bg 'fg=white'

function zsh_highlight_setup {
  ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets pattern cursor)
  ZSH_HIGHLIGHT_PATTERNS+=('rm -rf [~/]*' 'fg=white,bold,bg=red')
  ZSH_HIGHLIGHT_STYLES[path]=''
}

# two cached scripts (regenerated when plugins.toml changes):
#   sync.zsh  - zsh-defer + fpath entries, needed before the first prompt
#   defer.zsh - the other plugins, sourced in one zsh-defer task after it
_sheldon_cache=${XDG_CACHE_HOME:-$HOME/.cache}/sheldon
if [[ ! -s $_sheldon_cache/sync.zsh || ! -s $_sheldon_cache/defer.zsh ||
      ~/.config/sheldon/plugins.toml -nt $_sheldon_cache/sync.zsh ]]; then
  mkdir -p $_sheldon_cache
  sheldon lock >/dev/null 2>&1
  SHELDON_PROFILE=sync sheldon source > $_sheldon_cache/sync.zsh 2>/dev/null
  SHELDON_PROFILE=defer sheldon source > $_sheldon_cache/defer.zsh 2>/dev/null
fi
source $_sheldon_cache/sync.zsh

function _deferred_init {
  source $_sheldon_cache/defer.zsh
  zsh_highlight_setup
  source "$HOME/.zsh.d/fzf.zsh"
  eval "$(~/.local/bin/mise activate zsh)"
}
zsh-defer _deferred_init

for conf in "$HOME/.zsh.d/"*.zsh; do
  [[ "${conf:t}" == fzf.zsh ]] && continue
  source "${conf}"
done
unset conf
